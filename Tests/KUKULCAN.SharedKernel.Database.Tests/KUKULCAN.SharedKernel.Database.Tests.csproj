<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latestmajor</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>KUKULCAN.SharedKernel.Database.Tests</RootNamespace>
    <AssemblyName>KUKULCAN.SharedKernel.Database.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\KUKULCAN.SharedKernel.Database\KUKULCAN.SharedKernel.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixture projects live directly under Tests/. The historical copies under Coverage/
         are intentionally excluded so their generated obj files can never become test sources. -->
    <Compile Remove="Coverage\PartiallyLoadableProvider\**\*.cs" />
    <Compile Remove="Coverage\PartiallyLoadableProvider.MissingDependency\**\*.cs" />
  </ItemGroup>

  <Target Name="BuildSqlServerCoverageFixture" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\PartiallyLoadableProvider\PartiallyLoadableProvider.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
      BuildInParallel="false" />
  </Target>

  <Target Name="CopySqlServerCoverageFixture" AfterTargets="Build">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\PartiallyLoadableProvider\bin\$(Configuration)\$(TargetFramework)\Microsoft.EntityFrameworkCore.SqlServer.dll"
      DestinationFiles="$(TargetDir)SqlServerCoverageFixture.dll"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="NUnit" Version="4.*" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.*" />
    <PackageReference Include="NUnit.Analyzers" Version="4.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Moq" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
    <PackageReference Include="coverlet.collector" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TestResults\" />
  </ItemGroup>
</Project>
