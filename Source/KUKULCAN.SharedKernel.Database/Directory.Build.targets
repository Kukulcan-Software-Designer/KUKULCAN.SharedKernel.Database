<Project>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">true</GeneratePackageOnBuild>
        <SolutionDir>$(MSBuildThisFileDirectory)..\..\</SolutionDir>
        <PackageId>$(AssemblyName)</PackageId>
        <Version>$(VersionPrefix)</Version>
        <Authors>Kukulcán Software Designer</Authors>
        <Company>Kukulcán Software Designer</Company>
        <Copyright>GPL 2026 Kukulcán Software Designer</Copyright>
        <PackageProjectUrl>https://www.kukulcan.org.mx/Software/SharedKernel/Database</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageOutputPath>$(SolutionDir)NuGet\</PackageOutputPath>
        <PackageTags>kukulcan;sharedkernel;efcore;infrastructure</PackageTags>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>
            This release includes the following changes since v1.0.4:

            - Added idempotent Docker Compose launchers that reuse existing PostgreSQL and i18n containers when available.
            - Added support for an alternate Docker Compose environment file.
            - Added cross-platform Docker Compose launchers for macOS and Windows, alongside the Linux launcher.
            - Aligned the i18n Docker Compose configuration with the runtime database settings using Kukulcan__Database__Provider and Kukulcan__Database__ConnectionString.
            - Reused the PostgreSQL connection settings already present in an existing PostgreSQL container.
            - Added interactive PostgreSQL configuration prompts for missing database name, username, and password values, with password input hidden.
            - Added local JWT generation when creating the kukulcan-i18n service.
            - Added automated contract validation covering Docker Compose reuse, cross-platform launchers, and interactive database configuration.
        </PackageReleaseNotes>
        <RepositoryUrl>https://github.com/Kukulcan-Software-Designer/KUKULCAN.SharedKernel.Database</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>KUKULCAN.SharedKernel.Database is a reusable database infrastructure library for the KUKULCAN architecture. It provides Entity Framework Core integration, database context abstractions, entity persistence support, interceptors, transaction handling, database provider integration, and cross-cutting database behaviors, enabling consistent and standardized database access across applications, modules, and bounded contexts.

        This release extends the repository with Docker-based PostgreSQL documentation and configuration for the local ATLAS database environment. It also updates the project version information in Directory.Build.props and adds the XML AssemblyVersion and FileVersion assembly metadata fields, improving local development setup and assembly version identification.
        </Description>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
